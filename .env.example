# Z and Z OS · Environment variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel for prod.
# See WIRING.md for step-by-step setup of each service.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical host is WWW. Apex (zandzplumbing.com) must 301 -> www at the DNS/host
# layer. Keep this in sync with siteUrl in content/site-settings.ts.
NEXT_PUBLIC_SITE_URL=https://www.zandzplumbing.com

# ── Analytics ───────────────────────────────────────────────────────────────
# GA4 Measurement ID (Admin -> Data Streams -> Web). Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID (Clarity -> Settings -> Overview). Format: abcdefghij
NEXT_PUBLIC_CLARITY_ID=

# ── Admin auth (Z and Z OS) ─────────────────────────────────────────────────
# bcrypt hash of the admin password.
# Generate: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=

# 32+ character random string for signing admin session cookies.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase project → Settings → API. Use the service_role key on the
# server. NEVER expose service_role to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Private Supabase Storage bucket used for lead/job photos.
# The app will create this bucket with image-only restrictions if it is missing.
SUPABASE_JOB_PHOTOS_BUCKET=job-photos

# ── HubSpot ─────────────────────────────────────────────────────────────────
# Forms API (public, used by the booking form)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# Private App token (Settings → Integrations → Private Apps). Scopes needed:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read, crm.objects.deals.write,
#   crm.schemas.deals.read
# Used for: contact upsert + deal creation on every inbound lead.
HUBSPOT_PRIVATE_APP_TOKEN=

# Workflow webhook signing secret (generated when you create the webhook
# action in HubSpot Workflows). Used to validate incoming webhook signatures.
HUBSPOT_WEBHOOK_SECRET=

# Optional. Pin deals to a specific pipeline + stage. If unset, HubSpot drops
# the deal in the default pipeline's first stage.
# Find these in HubSpot → Settings → Objects → Deals → Pipelines.
HUBSPOT_DEALS_PIPELINE_ID=
HUBSPOT_DEALS_NEW_STAGE_ID=

# ── Twilio ──────────────────────────────────────────────────────────────────
# From console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Messaging Service SID (preferred): handles A2P 10DLC, failover, etc.
# Create one at Messaging → Services. Attach the phone number to the service.
TWILIO_MESSAGING_SERVICE_SID=

# Bare phone number (fallback if Messaging Service not set; E.164 format).
TWILIO_PHONE_NUMBER=

# Dispatch phone — where new-lead SMS alerts are sent. US 10-digit ok; the app
# normalizes to E.164. This is Jay (or whoever is dispatching).
DISPATCH_PHONE=

# ── Resend (lead notification emails) ───────────────────────────────────────
# API key from resend.com → API Keys. Free tier covers 3k emails/month.
RESEND_API_KEY=

# Where new-lead notification emails go. Comma-separated for multiple recipients.
# Example: jay@zandzplumbing.com,office@zandzplumbing.com
DISPATCH_EMAIL=

# Optional. The From address on dispatch emails. Must be a verified Resend domain.
# Default: "Z and Z Leads <leads@zandzplumbing.com>"
LEAD_FROM_EMAIL=

# Optional. The From address on customer invoice emails. Must be a verified Resend domain.
# Default falls back to LEAD_FROM_EMAIL.
INVOICE_FROM_EMAIL=

# ── Stripe invoices / payments ─────────────────────────────────────────────
# Secret key from Stripe Dashboard → Developers → API keys.
# Enables secure Checkout payment links inside Z and Z invoice emails.
STRIPE_SECRET_KEY=

# Webhook signing secret for /api/stripe/webhook.
# Subscribe to checkout.session.completed so paid invoices update automatically.
STRIPE_WEBHOOK_SECRET=

# ── Google review link ──────────────────────────────────────────────────────
# Build the short link via Google Business Profile → Reviews → "Share review form"
# Example shape: https://g.page/r/Cxxxxxxxxxxxxxxxx/review
GOOGLE_REVIEW_URL=https://g.page/r/replace-with-real-cid/review

# ── Cron auth (Vercel Cron) ─────────────────────────────────────────────────
# Vercel sets this automatically when configured. Treat as a secret bearer.
# Generate: openssl rand -base64 32
CRON_SECRET=
