# Z and Z OS · Environment variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel for prod.
# See WIRING.md for step-by-step setup of each service.

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zandzplumbing.com

# ── Admin auth (Z and Z OS) ─────────────────────────────────────────────────
# bcrypt hash of the admin password.
# Generate: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=

# 32+ character random string for signing admin session cookies.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase project → Settings → API. Use the service_role key on the
# server. NEVER expose service_role to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── HubSpot ─────────────────────────────────────────────────────────────────
# Forms API (public, used by the booking form)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=

# Private App token (Settings → Integrations → Private Apps). Scopes needed:
#   crm.objects.contacts.read, crm.objects.deals.read, crm.schemas.deals.read
HUBSPOT_PRIVATE_APP_TOKEN=

# Workflow webhook signing secret (generated when you create the webhook
# action in HubSpot Workflows). Used to validate incoming webhook signatures.
HUBSPOT_WEBHOOK_SECRET=

# ── Twilio ──────────────────────────────────────────────────────────────────
# From console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Messaging Service SID (preferred): handles A2P 10DLC, failover, etc.
# Create one at Messaging → Services. Attach the phone number to the service.
TWILIO_MESSAGING_SERVICE_SID=

# Bare phone number (fallback if Messaging Service not set; E.164 format).
TWILIO_PHONE_NUMBER=

# ── Google review link ──────────────────────────────────────────────────────
# Build the short link via Google Business Profile → Reviews → "Share review form"
# Example shape: https://g.page/r/Cxxxxxxxxxxxxxxxx/review
GOOGLE_REVIEW_URL=https://g.page/r/replace-with-real-cid/review

# ── Cron auth (Vercel Cron) ─────────────────────────────────────────────────
# Vercel sets this automatically when configured. Treat as a secret bearer.
# Generate: openssl rand -base64 32
CRON_SECRET=
